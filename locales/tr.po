#: core/effects.py mac_app/pages.py win_app/pages_win.py
msgid "A fine lens of light opens under pressure and closes softly behind the arriving pointer."
msgstr "Baskı altında ince bir ışık merceği açılır ve gelen imlecin ardından yumuşakça kapanır."

